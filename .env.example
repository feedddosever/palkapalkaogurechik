# ─────────────────────────────────────────────────────────────────────────────
# Leash configuration. EVERY variable is optional: with none set, Leash runs
# fully offline (PayPal simulator, catalog fixtures, heuristic AI fallbacks,
# embedded PGlite database). Add keys to switch each integration to live mode.
# Never commit real secrets. Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used for PayPal return URLs, webhooks, receipt links).
APP_URL=http://localhost:3000

# Database: Postgres connection string. Unset = embedded PGlite in .data/pglite
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's webhook settings (for signature verification)
PAYPAL_WEBHOOK_ID=
# auto = sandbox when credentials exist, otherwise simulator | sim | sandbox
PAYPAL_MODE=auto

# Claude via the Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model overrides (smart = agent/compiler, fast = guard)
AI_MODEL_SMART=
AI_MODEL_FAST=

# Channel3 product data API (trychannel3.com)
CHANNEL3_API_KEY=

# AG Grid Enterprise license key (trial watermark without it)
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# Ed25519 private key (PKCS#8 DER, base64) for signing intent receipts.
# Unset in development = an ephemeral key is generated at startup.
RECEIPT_SIGNING_KEY=
